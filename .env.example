# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret "service_role" key from the same page. Server only, never share it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Who can open /admin (confirmed email addresses, comma separated)
ADMIN_EMAILS=you@example.com

# Optional: AI keys. You can skip these and paste keys on the Admin page instead.
# A key saved on the Admin page is used first; these are the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
